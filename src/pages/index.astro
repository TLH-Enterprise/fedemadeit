---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import FeaturedPortfolio from "../components/FeaturedPortfolio.astro";
import Contact from "../components/Contact.astro";
import Clients from "../components/Clients.astro";
import { sessions } from "../data/portfolio";
import { clients } from "../data/clients";
import heroData from "../data/hero.json";
import featuredData from "../data/featured.json";

// Imagen de fondo del hero: camera.jpg en src/assets/hero/
const heroModules = import.meta.glob<{ default: import("astro").ImageMetadata }>("../assets/hero/*.{jpeg,jpg,png,webp}", { eager: true });
const heroBackground = heroModules["../assets/hero/camera.jpg"]?.default ?? Object.values(heroModules)[0]?.default;
---

<Layout title="FedeBlow | Portafolio de trabajo" description="Portafolio de Federico Rios - Videografía y fotografía">
	<Navbar sessions={sessions} />
	<main>
		<Hero
			name="Federico Ríos"
			subtitle="Photography — Videography — Design — AI Production"
			backgroundImage={heroBackground}
			backgroundVideoUrl={heroData.videoUrl}
		/>
		<FeaturedPortfolio items={featuredData.items} />
		<Clients clients={clients} label="Trabajos" title="Clientes" subtitle="Algunos proyectos con marcas y personas." />
		<Contact />
	</main>
</Layout>
