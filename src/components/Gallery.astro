---
import type { MediaItem, Session } from "../data/portfolio";
import { Image, getImage } from "astro:assets";

interface Props {
	items: MediaItem[];
	sessions: Session[];
}

const { items, sessions } = Astro.props;

const sessionById = Object.fromEntries(sessions.map((s) => [s.id, s]));
function getSessionName(sessionId: string | undefined): string {
	return sessionId ? sessionById[sessionId]?.name ?? "" : "";
}

const imageModules = import.meta.glob<{ default: import("astro").ImageMetadata }>(
	"../assets/portfolio/**/*.{webp,jpg,jpeg,png}",
	{ eager: true }
);

/** Pages CMS escribe rutas tipo "/src/assets/portfolio/<sesion>/archivo.webp";
 * los datos antiguos usan "<sesion>/archivo.webp". Se normalizan ambas al mismo formato. */
function normalizeAssetKey(assetKey: string) {
	return assetKey.replace(/^.*assets\/portfolio\//, "").replace(/^\/+/, "");
}

function getImageModule(assetKey: string) {
	const normalized = normalizeAssetKey(assetKey);
	const key = Object.keys(imageModules).find(
		(k) => k.replace(/^\.\.\/assets\/portfolio\//, "").replace(/\\/g, "/") === normalized
	);
	return key ? (imageModules[key] as { default: import("astro").ImageMetadata }).default : undefined;
}

function getYoutubeId(url: string): string | null {
	if (!url || typeof url !== "string") return null;
	const t = url.trim();
	if (/^[a-zA-Z0-9_-]{11}$/.test(t)) return t;
	const m = t.match(/(?:youtube\.com\/watch\?v=|youtube\.com\/shorts\/|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
	return m ? m[1] : null;
}
function getYoutubeEmbedUrl(id: string) {
	return `https://www.youtube.com/embed/${id}?autoplay=1`;
}
function getYoutubeThumbnail(id: string) {
	return `https://img.youtube.com/vi/${id}/maxresdefault.jpg`;
}
function getYoutubeThumbnailFallback(id: string) {
	return `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
}

type MediaEntry =
	| { type: "photo"; src: string; title: string }
	| { type: "video"; src: string; title: string; poster?: string; isYoutube?: boolean; isShort?: boolean };

interface CardData {
	item: MediaItem;
	mediaIndex: number;
	mediaEntry: MediaEntry | null;
	sessionName: string;
}

const allMedia: MediaEntry[] = [];
const cardDataList: CardData[] = [];

for (const item of items) {
	const sessionName = getSessionName(item.session);
	let mediaEntry: MediaEntry | null = null;

	if (item.type === "photo" && item.imageAsset) {
		const mod = getImageModule(item.imageAsset);
		if (mod) {
			const { src } = await getImage({ src: mod, width: 1200, quality: 95 });
			mediaEntry = { type: "photo", src, title: item.title || "Foto" };
		}
	} else if (item.type === "video" && item.videoUrl) {
		const ytId = getYoutubeId(item.videoUrl);
		if (ytId) {
			const isShort = item.videoUrl.includes("/shorts/");
			mediaEntry = {
				type: "video",
				src: getYoutubeEmbedUrl(ytId),
				title: item.title || "Video",
				poster: getYoutubeThumbnail(ytId),
				isYoutube: true,
				isShort,
			};
		} else {
			mediaEntry = {
				type: "video",
				src: item.videoUrl,
				title: item.title || "Video",
				poster: item.thumbnail,
			};
		}
	}

	if (mediaEntry) {
		cardDataList.push({ item, mediaIndex: allMedia.length, mediaEntry, sessionName });
		allMedia.push(mediaEntry);
	}
}

const sessionIdsWithPhotos = new Set<string>();
const sessionIdsWithVideos = new Set<string>();
for (const item of items) {
	if (!item.session) continue;
	if (item.type === "photo") sessionIdsWithPhotos.add(item.session);
	if (item.type === "video") sessionIdsWithVideos.add(item.session);
}
const sessionsForAll = sessions;
const sessionsForPhoto = sessions.filter((s) => sessionIdsWithPhotos.has(s.id));
const sessionsForVideo = sessions.filter((s) => sessionIdsWithVideos.has(s.id));
---

<section class="gallery-section" id="galeria" data-all-media={JSON.stringify(allMedia)}>
	<h2 class="section-title">Portfolio</h2>
	<p class="section-subtitle">Una selección de trabajos por categorías.</p>

	<div class="gallery-filter-bar">
		<div class="filter-row gallery-filters-type" role="tablist" aria-label="Filtrar por tipo de trabajo">
			<button type="button" class="filter-btn filter-btn--type is-active" data-type-filter="all" role="tab" aria-selected="true">Todo</button>
			<button type="button" class="filter-btn filter-btn--type" data-type-filter="photo" role="tab" aria-selected="false">Foto</button>
			<button type="button" class="filter-btn filter-btn--type" data-type-filter="video" role="tab" aria-selected="false">Video</button>
		</div>

		<div class="gallery-filters-sessions">
			<div class="filter-row gallery-filters-session" data-session-context="all" role="tablist" aria-label="Categoría" aria-hidden="false">
				<button type="button" class="filter-btn filter-btn--session is-active" data-session-filter="all" role="tab" aria-selected="true">Todas</button>
				{sessionsForAll.map((session) => (
					<button type="button" class="filter-btn filter-btn--session" data-session-filter={session.id} role="tab" aria-selected="false">
						{session.name}
					</button>
				))}
			</div>
			<div class="filter-row gallery-filters-session is-hidden" data-session-context="photo" role="tablist" aria-label="Categoría de fotografía" aria-hidden="true">
				<button type="button" class="filter-btn filter-btn--session is-active" data-session-filter="all" role="tab" aria-selected="true">Todas</button>
				{sessionsForPhoto.map((session) => (
					<button type="button" class="filter-btn filter-btn--session" data-session-filter={session.id} role="tab" aria-selected="false">
						{session.name}
					</button>
				))}
			</div>
			<div class="filter-row gallery-filters-session is-hidden" data-session-context="video" role="tablist" aria-label="Categoría de video" aria-hidden="true">
				<button type="button" class="filter-btn filter-btn--session is-active" data-session-filter="all" role="tab" aria-selected="true">Todas</button>
				{sessionsForVideo.map((session) => (
					<button type="button" class="filter-btn filter-btn--session" data-session-filter={session.id} role="tab" aria-selected="false">
						{session.name}
					</button>
				))}
			</div>
		</div>
	</div>

	<div class="grid grid-portfolio">
		{cardDataList.map(({ item, mediaIndex, mediaEntry, sessionName }) => {
			const typeLabel = item.type === "video" ? "Video" : "Foto";
			return item.type === "video" && item.videoUrl ? (
				getYoutubeId(item.videoUrl) ? (
					<button
						type="button"
						class="card card-video-btn"
						data-media-index={mediaIndex}
						data-item-type={item.type}
						data-item-session={item.session ?? ""}
						aria-label={item.title ? `Ver video: ${item.title}` : "Ver video"}
					>
						<div class="card-thumb">
							<img
								class="card-video-preview"
								src={getYoutubeThumbnail(getYoutubeId(item.videoUrl)!)}
								data-fallback={getYoutubeThumbnailFallback(getYoutubeId(item.videoUrl)!)}
								alt=""
								width={640}
								height={360}
								loading="lazy"
								onerror="this.onerror=null;this.src=this.dataset.fallback||''"
							/>
							<span class="card-badge" aria-hidden="true">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
									<path d="M8 5v14l11-7z" />
								</svg>
							</span>
						</div>
						<div class="card-info">
							<p class="card-title">{item.title || "—"}</p>
							<p class="card-type">{typeLabel}</p>
							<p class="card-session">{sessionName}</p>
						</div>
					</button>
				) : (
					<button
						type="button"
						class="card card-video-btn"
						data-media-index={mediaIndex}
						data-item-type={item.type}
						data-item-session={item.session ?? ""}
						aria-label={item.title ? `Ver video: ${item.title}` : "Ver video"}
					>
						<div class="card-thumb">
							<video
								class="card-video-preview"
								{...(item.thumbnail && !item.thumbnail.endsWith(".mp4") && !item.thumbnail.endsWith(".mov") ? { poster: item.thumbnail } : {})}
								src={item.videoUrl}
								muted
								autoplay
								loop
								playsinline
								webkit-playsinline="true"
								preload="metadata"
								aria-hidden="true"
							></video>
							<span class="card-badge" aria-hidden="true">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
									<path d="M8 5v14l11-7z" />
								</svg>
							</span>
						</div>
						<div class="card-info">
							<p class="card-title">{item.title || "—"}</p>
							<p class="card-type">{typeLabel}</p>
							<p class="card-session">{sessionName}</p>
						</div>
					</button>
				)
			) : item.type === "photo" && item.imageAsset && mediaEntry?.type === "photo" ? (
				(() => {
					const mod = getImageModule(item.imageAsset);
					return mod ? (
						<button
							type="button"
							class="card card-photo"
							data-media-index={mediaIndex}
							data-item-type={item.type}
							data-item-session={item.session ?? ""}
							aria-label={item.title ? `Ver ${item.title} en grande` : "Ver foto en grande"}
						>
							<div class="card-thumb">
								<Image
									src={mod}
									alt={item.title || "Foto del portafolio"}
									width={640}
									height={360}
									quality={90}
									loading="lazy"
									decoding="async"
									class="card-thumb-img"
								/>
							</div>
							<div class="card-info">
								<p class="card-title">{item.title || "—"}</p>
								<p class="card-type">{typeLabel}</p>
								<p class="card-session">{sessionName}</p>
							</div>
						</button>
					) : (
						<div class="card card-photo card-thumb-placeholder-wrap" data-item-type={item.type} data-item-session={item.session ?? ""}>
							<div class="card-thumb card-thumb-placeholder">Sin imagen</div>
							<div class="card-info">
								<p class="card-title">{item.title || "—"}</p>
								<p class="card-type">{typeLabel}</p>
								<p class="card-session">{sessionName}</p>
							</div>
						</div>
					);
				})()
			) : null;
		})}
	</div>
</section>

<div class="media-modal" id="media-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Ver contenido">
	<button type="button" class="media-modal-close" aria-label="Cerrar" data-media-modal-close>×</button>
	<button type="button" class="media-modal-prev" aria-label="Anterior" data-media-modal-prev>
		<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
	</button>
	<button type="button" class="media-modal-next" aria-label="Siguiente" data-media-modal-next>
		<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
	</button>
	<div class="media-modal-backdrop" data-media-modal-close></div>
	<div class="media-modal-content">
		<img class="media-modal-img" src="" alt="Vista ampliada" data-media-modal-img />
		<video class="media-modal-video" controls playsinline preload="auto" autoplay data-media-modal-video>
			<track kind="captions" src="/captions/empty.vtt" srclang="es" label="Español" default />
		</video>
		<iframe class="media-modal-youtube" data-media-modal-youtube title="Reproducir video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
		<p class="media-modal-title" data-media-modal-title></p>
		<p class="media-modal-counter" data-media-modal-counter></p>
	</div>
</div>

<style>
	.gallery-section {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1.5rem 5rem;
	}

	.section-title {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-primary);
		margin-bottom: 0.25rem;
	}

	.section-subtitle {
		font-size: 0.95rem;
		text-align: center;
		color: var(--text-muted);
		margin-bottom: 2rem;
	}

	.gallery-filter-bar {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		margin-bottom: 2rem;
		max-width: 100%;
	}

	.filter-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		justify-content: flex-start;
	}

	.gallery-filters-type .filter-btn {
		font-size: 0.78rem;
		padding: 0.45rem 0.85rem;
	}

	.gallery-filters-session .filter-btn {
		font-size: 0.72rem;
		padding: 0.4rem 0.7rem;
		letter-spacing: 0.06em;
	}

	.gallery-filters-session.is-hidden {
		display: none;
	}

	.filter-btn {
		font-family: var(--font-body);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 3px;
		cursor: pointer;
		transition: color 0.2s, background 0.2s, border-color 0.2s;
		line-height: 1.2;
		text-align: center;
	}

	.filter-btn:hover {
		color: var(--text-primary);
		border-color: rgba(255, 255, 255, 0.45);
	}

	.filter-btn.is-active {
		color: var(--text-primary);
		border-color: rgba(255, 255, 255, 0.88);
		background: transparent;
	}

	.filter-btn:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.6);
		outline-offset: 2px;
	}

	.grid-portfolio {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.card {
		display: block;
		background: var(--bg-card);
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.06);
		transition: transform 0.2s, box-shadow 0.2s;
		text-align: left;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
	}

	.card-thumb {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.card-thumb img,
	.card-thumb .card-thumb-img,
	.card-thumb .card-video-preview {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.card-video-preview {
		background: #000;
	}

	.card-badge {
		position: absolute;
		bottom: 0.5rem;
		right: 0.5rem;
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.7);
		border-radius: 50%;
		color: #fff;
	}

	.card-info {
		padding: 0.9rem 1rem;
	}

	.card-title {
		font-size: 0.95rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--text-primary);
		margin-bottom: 0.25rem;
	}

	.card-type,
	.card-session {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin: 0;
	}

	.card-session {
		margin-top: 0.15rem;
	}

	.card-photo,
	.card-video-btn {
		width: 100%;
		cursor: pointer;
		font: inherit;
		color: inherit;
		border: none;
		background: none;
		padding: 0;
	}

	.card-thumb-placeholder-wrap {
		display: block;
		width: 100%;
		cursor: default;
	}

	.card-thumb-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg-dark);
		color: var(--text-muted);
	}

	.card.is-hidden {
		display: none;
	}

	/* Media Modal */
	.media-modal {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3rem 4rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.25s, visibility 0.25s;
	}

	.media-modal.is-open {
		opacity: 1;
		visibility: visible;
	}

	.media-modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.92);
		cursor: pointer;
	}

	.media-modal-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 98vw;
		max-height: 95vh;
	}

	.media-modal-img,
	.media-modal-video,
	.media-modal-youtube {
		max-width: 100%;
		width: 100%;
		height: auto;
		border-radius: 8px;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
		display: none;
	}

	.media-modal-img {
		object-fit: contain;
		aspect-ratio: auto;
		max-height: 92vh;
	}

	.media-modal-video {
		background: #000;
		aspect-ratio: auto;
		max-height: 92vh;
	}

	.media-modal-youtube {
		aspect-ratio: 16 / 9;
		width: 100%;
		max-width: 98vw;
		max-height: 93vh;
		min-height: 480px;
	}

	.media-modal.show-youtube-short .media-modal-youtube {
		aspect-ratio: 9 / 16;
		width: auto;
		min-height: 82vh;
		max-height: 92vh;
		max-width: min(98vw, calc(92vh * 9 / 16));
	}

	.media-modal.show-image .media-modal-img {
		display: block;
	}

	.media-modal.show-video .media-modal-video {
		display: block;
	}

	.media-modal.show-youtube .media-modal-youtube {
		display: block;
	}

	.media-modal-title {
		margin-top: 1rem;
		font-size: 1rem;
		font-weight: 500;
		color: var(--text-primary);
	}

	.media-modal-counter {
		margin-top: 0.25rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.media-modal-close {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		z-index: 3;
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2rem;
		line-height: 1;
		color: var(--text-primary);
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		cursor: pointer;
		transition: background 0.2s;
	}

	.media-modal-close:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	.media-modal-prev,
	.media-modal-next {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 3;
		width: 52px;
		height: 52px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-primary);
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		cursor: pointer;
		transition: background 0.2s;
	}

	.media-modal-prev {
		left: 1.5rem;
	}

	.media-modal-next {
		right: 1.5rem;
	}

	.media-modal-prev:hover,
	.media-modal-next:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	@media (max-width: 600px) {
		.grid-portfolio {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.75rem;
		}

		.card-info {
			padding: 0.6rem 0.75rem;
		}

		.card-title {
			font-size: 0.75rem;
		}

		.card-type,
		.card-session {
			font-size: 0.7rem;
		}

		.media-modal {
			padding: 2rem 1rem;
		}

		.media-modal-prev {
			left: 0.5rem;
		}

		.media-modal-next {
			right: 0.5rem;
		}

		.media-modal-close {
			top: 0.75rem;
			right: 0.75rem;
		}
	}
</style>

<script>
	type MediaItem = { type: "photo" | "video"; src: string; title: string; poster?: string; isYoutube?: boolean; isShort?: boolean };

	const gallerySection = document.querySelector(".gallery-section");
	const mediaModal = document.getElementById("media-modal");
	const mediaImg = document.querySelector("[data-media-modal-img]") as HTMLImageElement;
	const mediaVideo = document.querySelector("[data-media-modal-video]") as HTMLVideoElement;
	const mediaTitle = document.querySelector("[data-media-modal-title]");
	const mediaCounter = document.querySelector("[data-media-modal-counter]");
	const closeTriggers = document.querySelectorAll("[data-media-modal-close]");
	const prevBtn = document.querySelector("[data-media-modal-prev]");
	const nextBtn = document.querySelector("[data-media-modal-next]");

	let mediaItems: MediaItem[] = [];
	let currentMediaIndex = 0;

	function getAllMedia(): MediaItem[] {
		const json = gallerySection?.getAttribute("data-all-media");
		if (!json) return [];
		try {
			return JSON.parse(json) as MediaItem[];
		} catch {
			return [];
		}
	}

	function openMediaModal(index: number) {
		mediaItems = getAllMedia();
		if (index < 0 || index >= mediaItems.length) return;
		currentMediaIndex = index;
		updateMedia();
		if (mediaModal) {
			mediaModal.classList.add("is-open");
			mediaModal.setAttribute("aria-hidden", "false");
			document.body.style.overflow = "hidden";
		}
		prevBtn?.setAttribute("aria-hidden", mediaItems.length <= 1 ? "true" : "false");
		nextBtn?.setAttribute("aria-hidden", mediaItems.length <= 1 ? "true" : "false");
	}

	const mediaYoutube = document.querySelector("[data-media-modal-youtube]") as HTMLIFrameElement | null;

	function closeMediaModal() {
		if (mediaModal) {
			if (mediaVideo) {
				mediaVideo.pause();
				mediaVideo.removeAttribute("src");
				mediaVideo.load();
			}
			if (mediaYoutube) mediaYoutube.removeAttribute("src");
			mediaModal.classList.remove("is-open", "show-image", "show-video", "show-youtube", "show-youtube-short");
			mediaModal.setAttribute("aria-hidden", "true");
			document.body.style.overflow = "";
		}
	}

	function updateMedia() {
		if (!mediaItems.length || !mediaModal) return;
		const item = mediaItems[currentMediaIndex];

		mediaModal.classList.remove("show-image", "show-video", "show-youtube", "show-youtube-short");

		if (item.type === "photo") {
			mediaImg.src = item.src;
			mediaImg.alt = item.title || "Vista ampliada de la foto del portafolio";
			mediaModal.classList.add("show-image");
			if (mediaVideo) mediaVideo.pause();
			if (mediaYoutube) mediaYoutube.removeAttribute("src");
		} else if (item.type === "video") {
			if (item.isYoutube && mediaYoutube) {
				mediaYoutube.src = item.src;
				mediaModal.classList.add("show-youtube");
				if (item.isShort) mediaModal.classList.add("show-youtube-short");
				if (mediaVideo) mediaVideo.pause();
			} else {
				mediaVideo!.src = item.src;
				if (item.poster) {
					mediaVideo!.setAttribute("poster", item.poster);
				} else {
					mediaVideo!.removeAttribute("poster");
				}
				mediaVideo!.load();
				mediaVideo!.play().catch(() => {});
				mediaModal.classList.add("show-video");
				if (mediaYoutube) mediaYoutube.removeAttribute("src");
			}
		}

		if (mediaTitle) mediaTitle.textContent = item.title;
		if (mediaCounter) mediaCounter.textContent = `${currentMediaIndex + 1} / ${mediaItems.length}`;
	}

	function goPrev() {
		if (mediaItems.length <= 1) return;
		currentMediaIndex = currentMediaIndex === 0 ? mediaItems.length - 1 : currentMediaIndex - 1;
		updateMedia();
	}

	function goNext() {
		if (mediaItems.length <= 1) return;
		currentMediaIndex = currentMediaIndex === mediaItems.length - 1 ? 0 : currentMediaIndex + 1;
		updateMedia();
	}

	type TypeFilter = "all" | "photo" | "video";

	let currentTypeFilter: TypeFilter = "all";
	let currentSessionFilter = "all";

	function applyFilters() {
		document.querySelectorAll(".gallery-section .card").forEach((card) => {
			const session = card.getAttribute("data-item-session") ?? "";
			const itemType = card.getAttribute("data-item-type") ?? "";
			const sessionOk = currentSessionFilter === "all" || session === currentSessionFilter;
			const typeOk =
				currentTypeFilter === "all" ||
				(currentTypeFilter === "photo" && itemType === "photo") ||
				(currentTypeFilter === "video" && itemType === "video");
			card.classList.toggle("is-hidden", !(sessionOk && typeOk));
		});
	}

	function syncSessionPanels() {
		document.querySelectorAll(".gallery-filters-session").forEach((row) => {
			const ctx = row.getAttribute("data-session-context") as TypeFilter | "all" | null;
			const visible = ctx === currentTypeFilter;
			row.classList.toggle("is-hidden", !visible);
			row.setAttribute("aria-hidden", visible ? "false" : "true");
		});
	}

	function resetSessionSelectionInActivePanel() {
		currentSessionFilter = "all";
		const panel = document.querySelector(
			`.gallery-filters-session[data-session-context="${currentTypeFilter}"]`
		);
		panel?.querySelectorAll(".filter-btn--session").forEach((b) => b.classList.remove("is-active"));
		panel?.querySelector('.filter-btn--session[data-session-filter="all"]')?.classList.add("is-active");
		panel?.querySelectorAll(".filter-btn--session").forEach((b) => {
			b.setAttribute("aria-selected", b.classList.contains("is-active") ? "true" : "false");
		});
	}

	document.querySelectorAll(".filter-btn--type").forEach((btn) => {
		btn.addEventListener("click", () => {
			const next = (btn.getAttribute("data-type-filter") ?? "all") as TypeFilter;
			if (next === currentTypeFilter) return;
			currentTypeFilter = next;
			document.querySelectorAll(".filter-btn--type").forEach((b) => {
				const active = b === btn;
				b.classList.toggle("is-active", active);
				b.setAttribute("aria-selected", active ? "true" : "false");
			});
			syncSessionPanels();
			resetSessionSelectionInActivePanel();
			applyFilters();
		});
	});

	document.querySelectorAll(".filter-btn--session").forEach((btn) => {
		btn.addEventListener("click", () => {
			const panel = btn.closest(".gallery-filters-session");
			if (!panel || panel.classList.contains("is-hidden")) return;
			currentSessionFilter = btn.getAttribute("data-session-filter") ?? "all";
			panel.querySelectorAll(".filter-btn--session").forEach((b) => {
				const active = b === btn;
				b.classList.toggle("is-active", active);
				b.setAttribute("aria-selected", active ? "true" : "false");
			});
			applyFilters();
		});
	});

	syncSessionPanels();
	applyFilters();

	// Card click -> open modal
	document.querySelectorAll(".card-photo, .card-video-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			const index = parseInt(btn.getAttribute("data-media-index") ?? "0", 10);
			openMediaModal(index);
		});
	});

	closeTriggers.forEach((el) => el.addEventListener("click", closeMediaModal));
	prevBtn?.addEventListener("click", goPrev);
	nextBtn?.addEventListener("click", goNext);

	mediaModal?.addEventListener("click", (e) => {
		if (e.target === mediaModal) closeMediaModal();
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && mediaModal?.classList.contains("is-open")) closeMediaModal();
		if (e.key === "ArrowLeft" && mediaModal?.classList.contains("is-open")) goPrev();
		if (e.key === "ArrowRight" && mediaModal?.classList.contains("is-open")) goNext();
	});

	const videoPreviewElements = document.querySelectorAll("video.card-video-preview");
	function playVideo(video: HTMLVideoElement) {
		video.muted = true;
		if (video.readyState >= 2) {
			video.play().catch(() => {});
		} else {
			video.addEventListener("canplay", () => {
				video.play().catch(() => {});
			}, { once: true });
		}
	}

	if (videoPreviewElements.length > 0 && "IntersectionObserver" in window) {
		const videoObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const video = entry.target as HTMLVideoElement;
					if (entry.isIntersecting) playVideo(video);
					else video.pause();
				});
			},
			{ threshold: 0.5 }
		);
		videoPreviewElements.forEach((video) => videoObserver.observe(video));
	}
</script>
