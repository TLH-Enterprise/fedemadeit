---
import { getImage } from "astro:assets";

interface FeaturedItem {
	title: string;
	image: string;
}

interface Props {
	items: FeaturedItem[];
}

const { items } = Astro.props;

const imageModules = import.meta.glob<{ default: import("astro").ImageMetadata }>(
	"../assets/portfolio/**/*.{webp,jpg,jpeg,png}",
	{ eager: true }
);

/** Pages CMS escribe rutas tipo "/src/assets/portfolio/<sesion>/archivo.webp". */
function normalizeAssetKey(assetKey: string) {
	return assetKey.replace(/^.*assets\/portfolio\//, "").replace(/^\/+/, "");
}

function getImageModule(assetKey: string) {
	const normalized = normalizeAssetKey(assetKey);
	const key = Object.keys(imageModules).find(
		(k) => k.replace(/^\.\.\/assets\/portfolio\//, "").replace(/\\/g, "/") === normalized
	);
	return key ? (imageModules[key] as { default: import("astro").ImageMetadata }).default : undefined;
}

const cards = await Promise.all(
	items.map(async (item) => {
		const mod = item.image ? getImageModule(item.image) : undefined;
		const thumbSrc = mod ? (await getImage({ src: mod, width: 800, quality: 90 })).src : null;
		return { title: item.title, thumbSrc };
	})
);
---

<section class="featured-portfolio" id="galeria">
	<div class="featured-portfolio-inner">
		<a href="/portfolio" class="featured-portfolio-btn">Ver portfolio</a>
		<div class="featured-portfolio-grid">
			{cards.map(({ title, thumbSrc }) => (
				<div class="featured-card">
					<div class="featured-card-thumb">
						{thumbSrc ? (
							<img src={thumbSrc} alt="" width={640} height={400} loading="lazy" class="featured-card-img" />
						) : (
							<div class="featured-card-placeholder">Sin imagen</div>
						)}
					</div>
					<p class="featured-card-title">{title || "—"}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.featured-portfolio {
		background: var(--bg-dark);
		padding: 4rem 1.5rem 4rem;
	}

	.featured-portfolio-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
	}

	.featured-portfolio-btn {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--text-primary);
		background: transparent;
		border: 2px solid rgba(255, 255, 255, 0.9);
		padding: 0.75rem 1.75rem;
		text-decoration: none;
		transition: background 0.2s, color 0.2s;
	}

	.featured-portfolio-btn:hover {
		background: rgba(255, 255, 255, 0.12);
		color: var(--text-primary);
	}

	.featured-portfolio-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		width: 100%;
	}

	.featured-card {
		display: block;
		color: inherit;
		background: var(--bg-card);
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.06);
	}

	.featured-card-thumb {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--bg-dark);
	}

	.featured-card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.featured-card-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.featured-card-title {
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--text-primary);
		padding: 1rem;
		margin: 0;
	}

	@media (max-width: 768px) {
		.featured-portfolio-grid {
			grid-template-columns: 1fr;
			max-width: 400px;
			margin: 0 auto;
		}
	}
</style>
